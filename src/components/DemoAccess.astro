---
import {demoAccessFor,demoAccessUI} from '../content/demo-access';
import type {CatalogSlug} from '../content/portfolio-catalog';
import type {Locale} from '../content';
import Icon from './RedesignIcon.astro';
import '../styles/demo-access.css';
interface Props {locale:Locale;slug:CatalogSlug;idPrefix:string;compact?:boolean;class?:string}
const {locale,slug,idPrefix,compact=false,class:className}=Astro.props;
const access=demoAccessFor(slug,locale),t=demoAccessUI(locale),first=access.accounts[0];
---
{access.mode==='accounts' ? <section class:list={['ox-demo-access',compact&&'is-compact',className]} id={idPrefix} aria-labelledby={`${idPrefix}-title`} data-demo-access data-demo-project={slug} data-accounts={JSON.stringify(access.accounts)} data-copying={t.copying} data-copied={t.copied} data-copy-failed={t.failed}>
  <div class="ox-demo-access-heading"><h3 id={`${idPrefix}-title`}>{t.title}</h3><span>{access.accounts.length}</span></div>
  <label class="ox-demo-access-role" for={`${idPrefix}-role`}>{t.role}<select id={`${idPrefix}-role`} data-demo-role>{access.accounts.map((account,index)=><option value={index}>{account.role}</option>)}</select></label>
  <div class="ox-demo-access-fields">
    {(['email','password'] as const).map(field=><div class="ox-demo-access-field"><label for={`${idPrefix}-${field}`}>{t[field]}</label><div><input id={`${idPrefix}-${field}`} type="text" value={first[field]} readonly autocomplete="off" spellcheck="false" data-demo-value={field} /><button type="button" data-demo-copy={field} aria-label={`${t.copy} — ${t[field]}`} title={`${t.copy} — ${t[field]}`} hidden><Icon name="files" size={18} /></button></div></div>)}
  </div>
  <p class="ox-demo-access-status" role="status" aria-live="polite" data-demo-copy-status></p>
  <p class="ox-demo-access-note">{t.note}</p>
  <noscript><details class="ox-demo-access-fallback"><summary>{t.all}</summary>{access.accounts.map(account=><div><strong>{account.role}</strong><p>{t.email}: <code>{account.email}</code></p><p>{t.password}: <code>{account.password}</code></p></div>)}</details></noscript>
</section> : <p class:list={['ox-demo-access-info',compact&&'is-compact']} data-demo-access-mode={access.mode}>{access.mode==='none'?t.noAccount:t.chatgpt}</p>}
<script>import '../scripts/demo-access';</script>
