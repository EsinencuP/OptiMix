---
import Icon from './RedesignIcon.astro';
import { content, homeAnchor, locales, pathFor, type Locale, type PageKind } from '../content';
import { homeRedesign } from '../content/home-redesign';
interface Props { locale: Locale; page: PageKind; slug?: string }
const { locale, page, slug } = Astro.props;
const t = homeRedesign(locale);
const anchors = ['services','demo-projects','approach','faq'];
const anchor = (id: string) => page === 'home' ? '#' + id : homeAnchor(locale,id);
const home = page === 'home' ? '#top' : pathFor(locale,'home');
const language = content[locale].ui.language;
---
<header class="ox-header"><div class="ox-container ox-header-inner">
  <a class="ox-brand" href={home} aria-label="Optimix"><img src="/images/redesign/brand-mark.png" width="22" height="22" alt="" /><span translate="no">OPTIMIX</span></a>
  <nav class="ox-desktop-nav" aria-label={t.menu}>{t.nav.map((label,i) => <a href={anchor(anchors[i])}>{label}{i < 2 && <Icon name="caret-down" size={14} />}</a>)}</nav>
  <div class="ox-header-actions"><nav class="ox-languages" aria-label={language}>{locales.map(target => <a data-locale-link href={pathFor(target,page,slug)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target.toUpperCase()}</a>)}</nav>{page !== 'contact' && <a class="ox-button ox-header-cta" href={pathFor(locale,'contact')}><span class="ox-desktop-label">{t.action}</span><span class="ox-mobile-label">{t.brief}</span></a>}
    <button class="ox-menu-trigger" type="button" popovertarget="ox-mobile-nav" aria-label={t.menu} aria-expanded="false" aria-controls="ox-mobile-nav"><Icon name="list" size={26} /></button>
  </div>
  <nav id="ox-mobile-nav" class="ox-mobile-nav" popover aria-label={t.menu}>{t.nav.map((label,i) => <a href={anchor(anchors[i])}>{label}<Icon name="arrow-right" size={20} /></a>)}<div class="ox-languages" aria-label={language}>{locales.map(target => <a data-locale-link href={pathFor(target,page,slug)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target.toUpperCase()}</a>)}</div></nav>
</div></header>
<script>import '../scripts/site-header';</script>
