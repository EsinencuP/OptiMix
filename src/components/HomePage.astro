---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './RedesignIcon.astro';
import ProcessScene from './HomeProcessScene.astro';
import DemoProjects from './DemoProjectGallery.astro';
import { pathFor, type Locale } from '../content';
import { demoPath, modulePath } from '../content/portfolio';
import { homeRedesign } from '../content/home-redesign';
import '../styles/demo-projects.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = homeRedesign(locale);
const contact = pathFor(locale,'contact');
const systemIcons = ['address-book','gear','file-text','table','users','database'];
const stageIcons = ['file-text','database','users','gear','chart-bar'];
const stageSlugs = ['intake','budget','approval','erp','visibility'] as const;
const sceneKinds = ['intake','systems','planning'] as const;
---
<BaseLayout title={`Optimix — ${t.eyebrow}`} description={t.intro} locale={locale} page="home">
<SiteHeader locale={locale} page="home" />
  <main id="main">
    <section class="ox-hero" id="top" aria-labelledby="ox-hero-title">
      <img class="ox-spark ox-spark-left" src="/images/redesign/accent-square.png" width="22" height="22" alt="" />
      <img class="ox-spark ox-spark-right" src="/images/redesign/accent-square.png" width="22" height="22" alt="" />
      <div class="ox-container">
        <div class="ox-hero-copy"><p class="ox-eyebrow">{t.eyebrow}</p><h1 id="ox-hero-title"><span>{t.title[0]}</span><span>{t.title[1]}</span></h1><p class="ox-hero-intro">{t.intro.split(' — ').map((line,i) => <span>{line}{i === 0 && ' — '}</span>)}</p><div class="ox-hero-actions"><a class="ox-button" href={contact}>{t.action}</a><a class="ox-button ox-button-secondary" href="#demo-projects">{t.example}</a></div><p class="ox-note"><span class="ox-desktop-label">{t.localNote}</span><span class="ox-mobile-label">{t.savedNote}</span></p></div>
        <ProcessScene locale={locale} kind="purchase" />
      </div>
    </section>
    <section class="ox-services ox-section" id="services" aria-labelledby="ox-services-title"><div class="ox-container">
      <div class="ox-section-heading"><h2 id="ox-services-title">{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div>
      <div class="ox-service-grid">{t.services.map(service => <a class="ox-service-card" href={`#${service.anchor}`}><Icon name={service.icon} size={46} /><div><h3>{service.title}</h3><p>{service.description}</p><span class="ox-learn">{t.learn}<Icon name="arrow-right" size={16} /></span></div><Icon class="ox-card-chevron" name="caret-right" size={22} /></a>)}</div>
      <p class="ox-other">{t.other} <a href={contact}>{t.action}<Icon name="arrow-right" size={18} /></a></p>
    </div></section>
    <DemoProjects locale={locale} />
    <section class="ox-examples" id="examples" aria-label={t.nav[1]}><div class="ox-container">
      {t.scenes.map((scene,i) => <article class:list={['ox-feature',i === 1 && 'ox-feature-reverse']} id={scene.id}><div class="ox-feature-copy"><h2>{scene.title}</h2><p>{scene.description}</p><ul class="ox-checks">{scene.checks.map(check => <li><Icon name="check-circle-fill" size={23} /><span>{check}</span></li>)}</ul></div><ProcessScene locale={locale} kind={sceneKinds[i]} /></article>)}
    </div></section>
    <section class="ox-workflow" id="workflow" aria-labelledby="ox-workflow-title"><div class="ox-container">
      <img class="ox-spark ox-workflow-spark-left" src="/images/redesign/accent-square.png" width="22" height="22" alt="" /><img class="ox-spark ox-workflow-spark-right" src="/images/redesign/accent-square.png" width="22" height="22" alt="" />
      <h2 id="ox-workflow-title"><span>{t.workflowTitle[0]}</span><span>{t.workflowTitle[1]}</span></h2>
      <div class="ox-workflow-route"><ol>{t.stages.map((stage,i) => <li><a href={modulePath(locale,stageSlugs[i])}><Icon name={stageIcons[i]} size={28} /><span>{stage}</span></a>{i < 4 && <Icon name="arrow-right" class="ox-route-arrow" size={30} />}</li>)}</ol><p class="ox-exception"><Icon name="warning" size={20} />{t.exception}</p></div>
      <a class="ox-button" href={demoPath(locale)}>{t.demoAction}</a>
    </div></section>
    <section class="ox-value ox-section" id="value" aria-labelledby="ox-value-title"><div class="ox-container"><h2 id="ox-value-title">{t.valueTitle}</h2><div class="ox-value-grid">{t.values.map(value => <article><Icon name={value.icon} size={44} /><div><h3>{value.title}</h3><p>{value.description}</p></div></article>)}</div></div></section>
    <section class="ox-start ox-section" id="approach" aria-labelledby="ox-start-title"><div class="ox-container"><div class="ox-section-heading"><h2 id="ox-start-title">{t.startTitle}</h2><p>{t.startIntro}</p></div><ol class="ox-start-grid">{t.steps.map((step,i) => <li><span class="ox-step-number">{i+1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div>{i < 3 && <Icon name="arrow-right" class="ox-step-arrow" size={28} />}</li>)}</ol></div></section>
    <section class="ox-systems ox-section" aria-labelledby="ox-systems-title"><div class="ox-container"><div class="ox-section-heading"><h2 id="ox-systems-title">{t.systemsTitle}</h2><p>{t.systemsIntro}</p></div><ul class="ox-system-list">{t.systems.map((label,i) => <li><Icon name={systemIcons[i]} size={25} />{label}</li>)}</ul></div></section>
    <section class="ox-faq ox-section" id="faq" aria-labelledby="ox-faq-title"><div class="ox-container ox-faq-grid"><div><h2 id="ox-faq-title">{t.faqTitle}</h2><p>{t.faqIntro}</p></div><div class="ox-faq-list">{t.faqs.map(faq => <details name="homepage-faq"><summary>{faq.question}<Icon name="plus" size={19} /></summary><p>{faq.answer}</p></details>)}</div></div></section>
    <section class="ox-final ox-section" id="contact" aria-labelledby="ox-final-title"><div class="ox-container"><h2 id="ox-final-title">{t.finalTitle}</h2><p>{t.finalIntro}</p><a class="ox-button" href={contact}>{t.action}</a><p class="ox-note">{t.savedNote}</p></div></section>
  </main>
  <SiteFooter locale={locale} page="home" />
</BaseLayout>
