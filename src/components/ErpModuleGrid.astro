---
import type { Locale } from '../content';
import { erpModuleIds, erpSupplementContent } from '../content/portfolio-pages';
import ErpModuleCard from './ErpModuleCard.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = erpSupplementContent[locale];
---
<section class="ox-erp-modules ox-container" id="erp-modules" aria-labelledby="erp-modules-title">
  <div class="ox-erp-section-heading">
    <p class="ox-page-kicker">{t.eyebrow}</p><h2 id="erp-modules-title">{t.title}</h2><p>{t.intro}</p>
  </div>
  <div class="ox-erp-module-grid">{erpModuleIds.map(id => <ErpModuleCard id={id} module={t.modules[id]} />)}</div>
</section>
