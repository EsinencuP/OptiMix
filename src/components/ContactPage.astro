---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { content, pathFor, type Locale } from '../content';
import '../styles/home.css';
import '../styles/inner.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
---
<BaseLayout title={t.meta.contactTitle} description={t.meta.contactDescription} locale={locale} page="contact">
  <SiteHeader locale={locale} page="contact" variant="inner" />
  <main id="main" class="inner-main">
    <div class="container inner-heading"><h1>{t.contactPage.title}</h1><p class="body-large muted">{t.contactPage.lead}</p></div>
    <div class="container brief-layout">
      <div class="brief-status"><strong>{t.contactPage.status}</strong><p>{t.contactPage.details}</p><a href={pathFor(locale, 'privacy')}>{t.contactPage.privacyLink} ↗</a></div>
      <section class="brief-builder" data-brief-builder data-filename={`optimix-process-brief-${locale}.txt`} data-title={t.contactPage.builderTitle} data-download-notice={t.contactPage.downloadNotice} aria-labelledby="brief-builder-title">
        <h2 id="brief-builder-title">{t.contactPage.builderTitle}</h2>
        <p class="brief-builder-intro">{t.contactPage.builderIntro}</p>
        <div class="brief-fields">
          <label>{t.contactPage.process}<input type="text" name="process" data-brief-field /></label>
          <label>{t.contactPage.description}<textarea name="description" rows="5" data-brief-field></textarea></label>
          <div class="form-two"><label>{t.contactPage.systems}<input type="text" name="systems" data-brief-field /></label><label>{t.contactPage.frequency}<input type="text" name="frequency" data-brief-field /></label></div>
          <label>{t.contactPage.problem}<textarea name="problem" rows="3" data-brief-field></textarea></label>
        </div>
        <button class="button-primary" type="button" data-download-brief disabled>{t.contactPage.download} <span aria-hidden="true">↓</span></button>
        <p class="download-status" role="status" data-download-status></p>
      </section>
    </div>
  </main>
  <SiteFooter locale={locale} page="contact" />
</BaseLayout>
