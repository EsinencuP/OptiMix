---
import { content, homeAnchor, locales, pathFor, type Locale, type PageKind } from '../content';
interface Props { locale: Locale; page?: PageKind; slug?: string }
const { locale, page = 'home', slug } = Astro.props;
const t = content[locale].ui;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand"><a class="wordmark" href={pathFor(locale, 'home')} translate="no">OPTI<span>MIX</span></a><p>{t.footerLine}</p></div>
      <nav class="footer-nav" aria-label={t.footerIndex}>
        <span>{t.footerIndex}</span>
        <a href={homeAnchor(locale, 'workflow')}>{t.process}</a>
        <a href={homeAnchor(locale, 'approach')}>{t.approach}</a>
        <a href={pathFor(locale, 'contact')}>{t.contact}</a>
        <a href={pathFor(locale, 'privacy')}>{t.privacy}</a>
      </nav>
      <nav class="footer-languages" aria-label={t.footerLanguages}>
        <span>{t.footerLanguages}</span>
        {locales.map((target) => <a href={pathFor(target, page, slug)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target.toUpperCase()}</a>)}
      </nav>
    </div>
    <div class="footer-bottom"><span>{t.footerNote}</span><a class="footer-top-link" href="#top"><span class="footer-top-icon" aria-hidden="true">↑</span>{t.backTop}</a></div>
  </div>
</footer>
