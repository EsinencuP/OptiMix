---
import { content, homeAnchor, locales, pathFor, type Locale, type PageKind } from '../content';
import { homeRedesign } from '../content/home-redesign';
interface Props { locale: Locale; page: PageKind; slug?: string }
const { locale, page, slug } = Astro.props;
const t = homeRedesign(locale);
const anchors = ['services','demo-projects','approach','faq'];
const anchor = (id: string) => page === 'home' ? '#' + id : homeAnchor(locale,id);
---
<footer class="ox-footer"><div class="ox-container ox-footer-inner"><div class="ox-footer-brand"><a class="ox-brand" href={page === 'home' ? '#top' : pathFor(locale,'home')} aria-label="Optimix"><img src="/images/redesign/brand-mark.png" width="18" height="18" alt="" /><span translate="no">OPTIMIX</span></a><p>{t.eyebrow}</p></div><nav class="ox-footer-nav" aria-label={t.menu}>{t.nav.map((label,i) => <a href={anchor(anchors[i])}>{label}</a>)}</nav><div class="ox-footer-meta"><nav class="ox-languages" aria-label={content[locale].ui.language}>{locales.map(target => <a data-locale-link href={pathFor(target,page,slug)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target.toUpperCase()}</a>)}</nav><a href={pathFor(locale,'privacy')}>{t.privacy}</a><span>Optimix · 2026</span></div></div></footer>
