---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './RedesignIcon.astro';
import Visual from './CatalogVisual.astro';
import Related from './CatalogRelated.astro';
import { portfolioCatalog, portfolioUI, type CatalogSlug } from '../content/portfolio-catalog';
import { pathFor, type Locale } from '../content';
import '../styles/portfolio-pages.css';
import '../styles/portfolio-catalog.css';
interface Props { locale: Locale; slug: CatalogSlug }
const {locale,slug}=Astro.props;
const project=portfolioCatalog(locale).find(project=>project.slug===slug)!;
const t=portfolioUI(locale);
---
<BaseLayout title={`${project.fullName} — ${t.eyebrow}`} description={project.description} locale={locale} page="portfolio" slug={slug}>
  <SiteHeader locale={locale} page="portfolio" slug={slug} />
  <main class="ox-catalog" id="main">
    <section class="ox-catalog-hero" id="top" aria-labelledby="catalog-title"><div class="ox-container ox-catalog-hero-layout">
      <div class="ox-catalog-hero-copy">
        <a class="ox-catalog-back" href={pathFor(locale,'portfolio')}><Icon name="arrow-left" size={18} />{t.eyebrow}</a>
        <p class="ox-page-kicker">{project.category}</p>
        <h1 id="catalog-title" translate="no">{project.fullName}</h1>
        <p class="ox-catalog-tagline">{project.headline}</p>
        <p class="ox-catalog-lead">{project.description}</p>
        <ul class="ox-catalog-tags">{project.tags.map(tag=><li>{tag}</li>)}</ul>
        <div class="ox-catalog-actions"><a class="ox-button" href={project.demo}>{t.demo}<Icon name="arrow-right" size={20} /></a><a class="ox-button ox-button-secondary" href={project.github}>{t.github}<Icon name="arrow-right" size={20} /></a></div>

      </div>
      <Visual project={project} locale={locale} />
    </div></section>
    {project.draft ? <section class="ox-container ox-catalog-draft" aria-labelledby="catalog-overview-title"><span class="ox-catalog-status">{t.draft}</span><h2 id="catalog-overview-title">{t.overview}</h2><p>{t.draftNote}</p></section> : <>
      <section class="ox-container ox-catalog-capabilities" aria-labelledby="catalog-capabilities-title"><p class="ox-page-kicker">{t.overview}</p><h2 id="catalog-capabilities-title">{t.capabilities}</h2><div class="ox-catalog-feature-grid">{project.features.map(feature=><article><Icon name={feature.icon} size={32} /><h3>{feature.title}</h3><p>{feature.description}</p></article>)}</div></section>
      <section class="ox-container ox-catalog-workflow" aria-labelledby="catalog-workflow-title"><h2 id="catalog-workflow-title">{t.workflow}</h2><ol>{t.steps.map((step,index)=><li><span>0{index+1}</span><h3>{step}</h3></li>)}</ol><p>{t.limits}</p></section>
    </>}
    <Related locale={locale} current={slug} />
    <section class="ox-catalog-cta"><div class="ox-container"><h2>{t.ask}</h2><a class="ox-button" href={pathFor(locale,'contact')}>{t.action}<Icon name="arrow-right" size={20} /></a></div></section>
  </main>
  <SiteFooter locale={locale} page="portfolio" slug={slug} />
</BaseLayout>
