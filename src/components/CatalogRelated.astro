---
import { portfolioCatalog, portfolioUI, type CatalogSlug } from '../content/portfolio-catalog';
import { pathFor, type Locale } from '../content';
import Icon from './RedesignIcon.astro';
import '../styles/portfolio-catalog.css';
interface Props { locale: Locale; current: CatalogSlug }
const {locale,current} = Astro.props;
const products=portfolioCatalog(locale);
const t=portfolioUI(locale);
const index=products.findIndex(project=>project.slug===current);
const previous=products[(index-1+products.length)%products.length];
const next=products[(index+1)%products.length];
---
<nav class="ox-catalog-related ox-container" aria-label={t.more}>
  <a href={previous.projectHref}><span>{t.previous}</span><strong translate="no">{previous.name}</strong></a>
  <a class="ox-catalog-all" href={pathFor(locale,'portfolio')}><Icon name="table" size={24} /><span>{t.all}</span></a>
  <a href={next.projectHref}><span>{t.next}</span><strong translate="no">{next.name}</strong></a>
</nav>
