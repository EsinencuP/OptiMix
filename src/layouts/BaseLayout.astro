---
import '../styles/global.css';
import '../styles/home-redesign.css';
import '../styles/site-pages.css';
import { ClientRouter } from 'astro:transitions';
import { content, locales, pathFor, type Locale, type PageKind } from '../content';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  page: PageKind;
  slug?: string;
  preloadImage?: { src: string; srcSet: string; sizes: string };
}

const { title, description, locale, page, slug, preloadImage } = Astro.props;
const ogLocale = locale === 'ro' ? 'ro_RO' : locale === 'ru' ? 'ru_RU' : 'en_GB';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ecfaf4" />
    <link rel="icon" href="/images/redesign/brand-mark.png" type="image/png" />
    <link rel="preload" href="/fonts/redesign/Roboto-Variable.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    {preloadImage && <link rel="preload" href={preloadImage.src} imagesrcset={preloadImage.srcSet} imagesizes={preloadImage.sizes} as="image" fetchpriority="high" />}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {Astro.site && locales.map((target) => <link rel="alternate" hreflang={target} href={new URL(pathFor(target, page, slug), Astro.site).href} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(pathFor('en', page, slug), Astro.site).href} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{content[locale].ui.skip}</a>
    <div class:list={['ox-home', page !== 'home' && 'ox-inner']}><slot /></div>
    <script>import '../scripts/brief-download';</script>
  </body>
</html>
