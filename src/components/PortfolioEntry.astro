---
import PortfolioPage from './PortfolioPage.astro';
import CatalogProjectPage from './CatalogProjectPage.astro';
import type { CatalogSlug } from '../content/portfolio-catalog';
import type { Locale } from '../content';
interface Props {locale:Locale; slug:CatalogSlug}
const {locale,slug}=Astro.props;
---
{slug === 'crm' || slug === 'erp' ? <PortfolioPage locale={locale} slug={slug} /> : <CatalogProjectPage locale={locale} slug={slug} />}
