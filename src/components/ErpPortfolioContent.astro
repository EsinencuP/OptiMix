---
import type { Locale } from '../content';
import { erpPageContent, erpTechnologies, erpHubIcons, portfolioPages, portfolioPageLinks } from '../content/portfolio-pages';
import Icon from './RedesignIcon.astro';
import ErpHubDiagram from './ErpHubDiagram.astro';
import ErpModuleGrid from './ErpModuleGrid.astro';
import ErpDemoCta from './ErpDemoCta.astro';
import '../styles/portfolio-erp.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = erpPageContent[locale];
const common = portfolioPages[locale];
const previewIds = ['finance', 'inventory', 'team'] as const;
---
<section class="ox-erp-hero" id="top" aria-labelledby="portfolio-title">
  <div class="ox-container ox-erp-hero-layout">
    <div class="ox-erp-hero-copy" data-erp-entrance>
      <p class="ox-page-kicker">{common.eyebrow}</p>
      <h1 id="portfolio-title">{common.projects.erp.title}<span>{t.heroAccent}</span></h1>
      <p class="ox-erp-lead">{common.projects.erp.intro}</p>
      <ul class="ox-erp-tags" aria-label={t.technologyLabel}>{erpTechnologies.map(tag => <li translate="no">{tag}</li>)}</ul>
      <div class="ox-erp-actions">
        <a class="ox-button" href={portfolioPageLinks.erp.demo}>{common.openDemo}<Icon name="arrow-right" size={20} /></a>
        <a class="ox-button ox-button-secondary" href={portfolioPageLinks.erp.github}>{common.github}<Icon name="arrow-right" size={20} /></a>
      </div>

    </div>
    <figure class="ox-erp-preview" data-erp-entrance aria-label={t.previewLabel}>
      <div class="ox-erp-window">
        <div class="ox-erp-window-bar"><Icon name="database" size={24} /><strong translate="no">Evo ERP</strong><span aria-hidden="true">•••</span></div>
        <div class="ox-erp-overview"><p class="ox-erp-overview-title">{t.previewTitle}</p><ul>
          {previewIds.map((id, index) => <li><span class="ox-erp-preview-icon"><Icon name={erpHubIcons[id]} size={26} /></span><div><strong>{t.hub.modules[id].title}</strong><p>{t.previewRows[index]}</p></div><Icon name="check-circle" size={21} /></li>)}
        </ul></div>
      </div>
      <figcaption>{t.previewCaption}</figcaption>
    </figure>
  </div>
</section>
<ErpHubDiagram locale={locale} />
<ErpModuleGrid locale={locale} />
<ErpDemoCta locale={locale} />
<script>import '../scripts/portfolio-erp';</script>
