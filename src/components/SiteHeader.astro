---
import { content, homeAnchor, locales, pathFor, type Locale, type PageKind } from '../content';

interface Props { locale: Locale; page: PageKind; variant?: 'hero' | 'inner' }
const { locale, page, variant = 'hero' } = Astro.props;
const t = content[locale].ui;
const processUrl = page === 'home' ? '#workflow' : homeAnchor(locale, 'workflow');
const approachUrl = page === 'home' ? '#approach' : homeAnchor(locale, 'approach');
const contactUrl = pathFor(locale, 'contact');
const homeUrl = page === 'home' ? '#top' : pathFor(locale, 'home');
---
<header id={page === 'home' ? undefined : 'top'} class:list={['site-header', variant === 'inner' && 'site-header-inner']}>
  <div class="container header-inner">
    <a class="wordmark" href={homeUrl} aria-label={`Optimix — ${t.home}`} translate="no">OPTI<span>MIX</span></a>
    <nav class="primary-nav" aria-label={t.menu}>
      <a class="nav-optional" href={processUrl}>{t.process}</a>
      <a class="nav-optional" href={approachUrl}>{t.approach}</a>
      {page !== 'contact' && <a class="nav-optional" href={contactUrl}>{t.contact}</a>}
      <div class="language-switch" aria-label={t.language}>
        {locales.map((target) => <a href={pathFor(target, page)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target.toUpperCase()}</a>)}
      </div>
      {page !== 'contact' && <a class="nav-contact" href={contactUrl}>{t.brief} <span aria-hidden="true">↗</span></a>}
    </nav>
    {page !== 'contact' && <a class="mobile-contact" href={contactUrl}>{t.briefShort} <span aria-hidden="true">↗</span></a>}
    <div class="mobile-menu">
      <button class="mobile-menu-trigger" type="button" popovertarget="mobile-nav" aria-controls="mobile-nav" aria-expanded="false">{t.menu} <span aria-hidden="true">+</span></button>
      <nav class="mobile-nav-popover" popover id="mobile-nav" aria-label={t.menu}>
        <a href={processUrl}>{t.process}</a>
        <a href={approachUrl}>{t.approach}</a>
        {page !== 'contact' && <a href={contactUrl}>{t.contact}</a>}
        <div class="mobile-languages" aria-label={t.language}>
          {locales.map((target) => <a href={pathFor(target, page)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target.toUpperCase()}</a>)}
        </div>
      </nav>
    </div>
  </div>
</header>
<script>import '../scripts/site-header';</script>
