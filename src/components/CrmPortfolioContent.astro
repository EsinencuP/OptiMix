---
import FeatureCard from './FeatureCard.astro';
import CrmWorkflowDiagram from './CrmWorkflowDiagram.astro';
import CrmModuleGrid from './CrmModuleGrid.astro';
import CrmDemoCta from './CrmDemoCta.astro';
import Icon from './RedesignIcon.astro';
import type { Locale } from '../content';
import { crmPageContent, crmTechnologies, portfolioPages, portfolioPageLinks } from '../content/portfolio-pages';
import '../styles/portfolio-crm.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = portfolioPages[locale];
const crm = crmPageContent[locale];
const project = t.projects.crm;
const links = portfolioPageLinks.crm;
---

<section class="ox-crm-hero" id="top" aria-labelledby="portfolio-title">
  <div class="ox-container ox-crm-hero-layout">
    <div class="ox-crm-hero-copy" data-crm-entrance>
      <p class="ox-page-kicker">{t.eyebrow}</p>
      <h1 id="portfolio-title">{project.title}<span>{crm.heroAccent}</span></h1>
      <p class="ox-crm-lead">{project.intro}</p>
      <ul class="ox-crm-tags" aria-label={crm.technologyLabel}>
        {crmTechnologies.map(tag => <li translate="no">{tag}</li>)}
      </ul>
      <div class="ox-crm-actions">
        <a class="ox-button" href={links.demo}>{t.openDemo}<Icon name="arrow-right" size={20} /></a>
        <a class="ox-button ox-button-secondary" href={links.github}>{t.github}<Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
    <figure class="ox-crm-preview" data-crm-entrance aria-label={crm.preview.label}>
      <div class="ox-crm-window">
        <div class="ox-crm-window-bar"><span class="ox-crm-window-mark" aria-hidden="true"><Icon name="table" size={20} /></span><strong translate="no">CRM Portfolio</strong><span class="ox-crm-window-dots" aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="ox-crm-board">
          <p class="ox-crm-board-title">{crm.preview.title}</p>
          <div class="ox-crm-board-columns">
            {crm.preview.stages.map((stage, index) => (
              <div class="ox-crm-board-column">
                <p class="ox-crm-stage"><span>{stage}</span><span class="ox-crm-stage-count">{crm.preview.deals[index].length}</span></p>
                <ul class="ox-crm-deals">
                  {crm.preview.deals[index].map(deal => (
                    <li><span class="ox-crm-deal-line" aria-hidden="true"></span><strong>{deal}</strong><span class="ox-crm-deal-owner"><Icon name="users" size={16} />{crm.preview.owner}</span></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
      <figcaption>{crm.preview.caption}</figcaption>
    </figure>
  </div>
</section>

<section class="ox-crm-features ox-container" aria-labelledby="crm-features-title">
  <div class="ox-crm-section-heading" data-crm-feature>
    <p class="ox-page-kicker">{crm.featuresEyebrow}</p>
    <h2 id="crm-features-title">{crm.featuresTitle}</h2>
    <p>{crm.featuresIntro}</p>
  </div>
  <div class="ox-crm-feature-grid">
    {crm.features.map((feature, index) => <FeatureCard feature={feature} wide={[0, 3, 5].includes(index)} />)}
  </div>
</section>

<CrmWorkflowDiagram locale={locale} />
<CrmModuleGrid locale={locale} />
<CrmDemoCta locale={locale} />

<script>import '../scripts/portfolio-crm';</script>
