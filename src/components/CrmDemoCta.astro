---
import type { Locale } from '../content';
import { crmSupplementContent, portfolioPages, portfolioPageLinks } from '../content/portfolio-pages';
import Icon from './RedesignIcon.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = crmSupplementContent[locale].cta;
const links = portfolioPageLinks.crm;
---
<section class="ox-crm-cta-section ox-container" id="crm-demo" aria-labelledby="crm-demo-cta-title">
  <div class="ox-crm-cta">
    <div><p class="ox-page-kicker">{t.eyebrow}</p><h2 id="crm-demo-cta-title">{t.title}</h2><p class="ox-crm-cta-intro">{t.intro}</p></div>
    <div class="ox-crm-cta-actions">
      <a class="ox-button" href={links.demo}>{portfolioPages[locale].openDemo}<Icon name="arrow-right" size={20} /></a>
      <a class="ox-button" href={links.github}>{portfolioPages[locale].github}<Icon name="arrow-right" size={20} /></a>
    </div>
  </div>
</section>
