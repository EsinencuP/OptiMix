---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Icon from './RedesignIcon.astro';
import ProcessScene from './HomeProcessScene.astro';
import HeroScene from './HomeHeroScene.astro';
import DemoProjects from './DemoProjectGallery.astro';
import { pathFor, type Locale } from '../content';
import { demoPath } from '../content/portfolio';
import { homeRedesign } from '../content/home-redesign';
import '../styles/demo-projects.css';
import '../styles/hero-v2.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = homeRedesign(locale);
const contact = pathFor(locale,'contact');
const sceneKinds = ['intake','systems','planning'] as const;
const leadScene = t.scenes[1];
---
<BaseLayout title={`Optimix — ${t.eyebrow}`} description={t.intro} locale={locale} page="home">
<SiteHeader locale={locale} page="home" />
  <main id="main">
    <section class="ox-hero ox-hero-examples ox-hero-v2" id="top" aria-labelledby="ox-hero-title">
      <div class="ox-hero-stage"><div class="ox-container" id="examples">
        <span id="workflow" aria-hidden="true"></span>
        <article class="ox-hero-primary" id={leadScene.id} aria-labelledby="ox-hero-title">
          <div class="ox-hero-message">
            <p class="ox-eyebrow">{t.eyebrow}</p>
            <h1 id="ox-hero-title"><span>{t.heroTitle[0]}</span>{' '}<span>{t.heroTitle[1]}</span></h1>
            <p class="ox-hero-intro">{leadScene.description}</p>
            <ul class="ox-checks">{leadScene.checks.map(check => <li><Icon name="check-circle-fill" size={23} /><span>{check}</span></li>)}</ul>
            <div class="ox-hero-actions"><a class="ox-button" href={contact}>{t.action}</a><a class="ox-button ox-button-secondary" href={demoPath(locale)}>{t.example}</a></div>
            <p class="ox-note">{t.savedNote}</p>
          </div>
          <HeroScene locale={locale} />
        </article>
      </div></div>
      <div class="ox-container">
        <div class="ox-hero-support">
          {t.scenes.map((scene,i) => i !== 1 && <article class="ox-hero-example" id={scene.id} aria-labelledby={`hero-${scene.id}`}>
            <div class="ox-hero-example-copy"><h2 id={`hero-${scene.id}`}>{scene.title}</h2><p>{scene.description}</p><ul class="ox-checks">{scene.checks.map(check => <li><Icon name="check-circle-fill" size={20} /><span>{check}</span></li>)}</ul></div>
            <ProcessScene locale={locale} kind={sceneKinds[i]} />
          </article>)}
        </div>
      </div>
    </section>
    <section class="ox-services ox-section" id="services" aria-labelledby="ox-services-title"><div class="ox-container">
      <div class="ox-section-heading"><h2 id="ox-services-title">{t.servicesTitle}</h2><p>{t.servicesIntro}</p></div>
      <div class="ox-service-grid">{t.services.map(service => <a class="ox-service-card" href={`#${service.anchor}`}><Icon name={service.icon} size={46} /><div><h3>{service.title}</h3><p>{service.description}</p><span class="ox-learn">{t.learn}<Icon name="arrow-right" size={16} /></span></div><Icon class="ox-card-chevron" name="caret-right" size={22} /></a>)}</div>
      <p class="ox-other">{t.other} <a href={contact}>{t.action}<Icon name="arrow-right" size={18} /></a></p>
    </div></section>
    <DemoProjects locale={locale} />
    <section class="ox-value ox-section" id="value" aria-labelledby="ox-value-title"><div class="ox-container"><h2 id="ox-value-title">{t.valueTitle}</h2><div class="ox-value-grid">{t.values.map(value => <article><Icon name={value.icon} size={44} /><div><h3>{value.title}</h3><p>{value.description}</p></div></article>)}</div></div></section>
    <section class="ox-start ox-section" id="approach" aria-labelledby="ox-start-title"><div class="ox-container"><div class="ox-section-heading"><h2 id="ox-start-title">{t.startTitle}</h2><p>{t.startIntro}</p></div><ol class="ox-start-grid">{t.steps.map((step,i) => <li><span class="ox-step-number">{i+1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div>{i < 3 && <Icon name="arrow-right" class="ox-step-arrow" size={28} />}</li>)}</ol></div></section>
    <section class="ox-faq ox-section" id="faq" aria-labelledby="ox-faq-title"><div class="ox-container ox-faq-grid"><div><h2 id="ox-faq-title">{t.faqTitle}</h2><p>{t.faqIntro}</p></div><div class="ox-faq-list">{t.faqs.map(faq => <details name="homepage-faq"><summary>{faq.question}<Icon name="plus" size={19} /></summary><p>{faq.answer}</p></details>)}</div></div></section>
    <section class="ox-final ox-section" id="contact" aria-labelledby="ox-final-title"><div class="ox-container"><h2 id="ox-final-title">{t.finalTitle}</h2><p>{t.finalIntro}</p><a class="ox-button" href={contact}>{t.action}</a><p class="ox-note">{t.savedNote}</p></div></section>
  </main>
  <SiteFooter locale={locale} page="home" />
</BaseLayout>
