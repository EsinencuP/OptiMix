---
import PortfolioPage from '../../../components/PortfolioEntry.astro';
import { catalogSlugs, type CatalogSlug } from '../../../content/portfolio-catalog';

export function getStaticPaths() {
  return catalogSlugs.map(slug => ({ params: { slug } }));
}
const slug = Astro.params.slug as CatalogSlug;
---
<PortfolioPage locale="ru" slug={slug} />
