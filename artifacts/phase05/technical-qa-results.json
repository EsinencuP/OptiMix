    "headings": [
      {
        "tag": "H1",
        "text": "Routine steps move. People decide."
      },
      {
        "tag": "H2",
        "text": "The work moves. The context does not."
      },
      {
        "tag": "H2",
        "text": "Make the route explicit before automating it."
      },
      {
        "tag": "H3",
        "text": "See the actual handoffs."
      },
      {
        "tag": "H3",
        "text": "Connect repeatable steps."
      },
      {
        "tag": "H3",
        "text": "Keep decisions accountable."
      },
      {
        "tag": "H2",
        "text": "Follow one request."
      },
      {
        "tag": "H3",
        "text": "Request submitted"
      },
      {
        "tag": "H3",
        "text": "Budget checked"
      },
      {
        "tag": "H3",
        "text": "Manager decision"
      },
      {
        "tag": "H3",
        "text": "Supplier selected"
      },
      {
        "tag": "H3",
        "text": "Purchase order recorded"
      },
      {
        "tag": "H3",
        "text": "Await shipment; update stock"
      },
      {
        "tag": "H3",
        "text": "Invoice checked"
      },
      {
        "tag": "H3",
        "text": "KPI / SLA record updated"
      },
      {
        "tag": "H2",
        "text": "The case has to work on paper, too."
      },
      {
        "tag": "H2",
        "text": "Start with the process, then choose the mechanism."
      },
      {
        "tag": "H2",
        "text": "Bring one process."
      }
