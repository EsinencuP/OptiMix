---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { getImage } from 'astro:assets';
import { content, pathFor, type Locale } from '../content';
import heroConcept from '../assets/hero-procurement-concept.webp';
import '../styles/home-critical.generated.css';
import deferredHomeCss from '../styles/home-deferred.generated.css?url';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const workflowKinds = ['human', 'validation', 'checkpoint', 'human', 'system', 'waiting', 'validation', 'complete'];
const heroImage = await getImage({ src: heroConcept, widths: [480, 960, 1672], sizes: '(min-width: 48rem) 52vw, 100vw', format: 'webp', quality: 80 });
---
<BaseLayout title={t.meta.homeTitle} description={t.meta.homeDescription} locale={locale} page="home" preloadImage={{ src: heroImage.src, srcSet: heroImage.srcSet.attribute, sizes: '(min-width: 48rem) 52vw, 100vw' }} deferredStylesheet={deferredHomeCss}>
  <SiteHeader locale={locale} page="home" />
  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-layout container">
        <div class="hero-body">
          <p class="eyebrow hero-eyebrow">{t.hero.eyebrow}</p>
          <h1 id="hero-title">{t.hero.lines.map((line, index) => <><span class="hero-title-mask"><span class:list={['hero-title-line', index === 2 && 'hero-title-accent']}>{line}</span></span>{index < t.hero.lines.length - 1 && ' '}</>)}</h1>
          <div class="hero-intro"><p class="body-large">{t.hero.intro}</p><div class="hero-actions"><a class="button-primary" href={pathFor(locale, 'contact')}>{t.ui.brief} <span aria-hidden="true">↗</span></a><a class="text-link" href="#workflow">{t.hero.secondary}</a></div></div>
        </div>
        <div class="hero-visual">
          <figure class="hero-art"><img src={heroImage.src} srcset={heroImage.srcSet.attribute} sizes="(min-width: 48rem) 52vw, 100vw" width={heroConcept.width} height={heroConcept.height} alt={t.hero.artAlt} fetchpriority="high" decoding="async" /></figure>
          <svg class="hero-process-line" viewBox="0 0 480 96" preserveAspectRatio="none" aria-hidden="true"><path class="hero-process-track" d="M26 48 H454"/><path class="hero-process-trace" d="M26 48 H454"/></svg>
          <div class="route-preview" aria-label={t.hero.previewLabel}><p class="route-preview-label">{t.hero.previewLabel}</p><ol>{t.hero.preview.map((item, index) => <li><span class="route-node" aria-hidden="true"></span><span class="mono-number">{String(index + 1).padStart(2, '0')}</span><span>{item}</span></li>)}</ol></div>
        </div>
      </div>
      <div class="hero-footer container"><p class="hero-credit">{t.hero.credit}</p></div>
    </section>
    <div class="editorial-break"><blockquote>{t.quotes.first}</blockquote></div>
    <section class="recognition" id="problem" aria-labelledby="problem-title"><div class="container"><div class="section-heading recognition-heading"><p class="eyebrow">{t.problem.eyebrow}</p><div><h2 class="section-title" id="problem-title">{t.problem.title}</h2><p class="body-large muted">{t.problem.lead}</p></div></div><div class="relay-viewport"><ol class="relay" aria-label={t.problem.relayLabel}>{t.problem.relay.map((item, index) => <li><span class="relay-number mono-number">{String(index + 1).padStart(2, '0')}</span><strong>{item.title}</strong><span>{item.detail}</span></li>)}</ol></div><div class="relay-scroll-cue"><span>{t.problem.swipeHint}</span><span class="relay-progress" aria-hidden="true"><span></span></span><div class="track-controls"><button type="button" data-track="relay" data-direction="-1" aria-label={t.ui.previous}>←</button><button type="button" data-track="relay" data-direction="1" aria-label={t.ui.next}>→</button></div></div><p class="example-note">{t.problem.note}</p></div></section>
    <section class="change container" id="change" aria-labelledby="change-title"><div class="change-lead"><p class="eyebrow">{t.change.eyebrow}</p><h2 class="section-title" id="change-title">{t.change.title}</h2><p class="body-large muted">{t.change.lead}</p></div><div class="change-sequence">{t.change.rows.map((row) => <div class="change-row"><span class="change-index mono-number">{row.label}</span><div><h3>{row.title}</h3><p>{row.detail}</p></div></div>)}</div><fieldset class="change-comparison"><legend class="sr-only">{t.change.compareLabel}</legend><div class="comparison-toggle"><input class="sr-only" type="radio" name="comparison" id="compare-before" checked /><label for="compare-before">{t.change.beforeTab}</label><input class="sr-only" type="radio" name="comparison" id="compare-after" /><label for="compare-after">{t.change.afterTab}</label></div><div class="comparison-panels"><div class="comparison-path comparison-before"><h3>{t.change.before}</h3><ol>{t.change.beforeSteps.map((step) => <li>{step}</li>)}</ol></div><div class="comparison-path comparison-after"><h3>{t.change.after}</h3><ol>{t.change.afterSteps.map((step) => <li>{step}</li>)}</ol><p>{t.change.afterNote}</p></div></div></fieldset></section>
    <div class="editorial-break"><blockquote>{t.quotes.second}</blockquote></div>
    <section class="workflow-scene" id="workflow" aria-labelledby="workflow-title"><div class="container workflow-grid"><div class="workflow-intro"><div><p class="eyebrow">{t.workflow.eyebrow}</p><h2 class="section-title" id="workflow-title">{t.workflow.title}</h2></div><div><p class="body-large">{t.workflow.lead}</p><p class="workflow-disclosure">{t.workflow.disclosure}</p><div class="workflow-legend"><span><i class="legend-marker human" aria-hidden="true"></i> {t.workflow.human}</span><span><i class="legend-marker system" aria-hidden="true"></i> {t.workflow.system}</span><span><i class="legend-marker checkpoint" aria-hidden="true"></i> {t.workflow.checkpoint}</span></div></div></div><div class="workflow-route" aria-label={t.workflow.routeHint}><span class="workflow-progress-line" aria-hidden="true"></span><ol class="workflow-steps">{t.workflow.steps.map((step, index) => <li class:list={['workflow-step', `is-${workflowKinds[index]}`]}><span class="workflow-marker" aria-hidden="true"></span><div class="workflow-step-top"><span class="mono-number">{String(index + 1).padStart(2, '0')}</span><span>{step.role} / {step.note}</span></div><h3>{step.title}</h3><p>{step.detail}</p>{index === 1 && <aside class="exception-route" aria-label={t.workflow.exceptionLabel}><span class="exception-heading">↳ {t.workflow.exceptionLabel}</span><p>{t.workflow.exceptionDetail}</p></aside>}</li>)}</ol></div><div class="workflow-tail"><p>{t.workflow.bottomline}</p><div class="workflow-route-progress" aria-hidden="true"><span></span></div><div class="track-controls"><button type="button" data-track="workflow-route" data-direction="-1" aria-label={t.ui.previous}>←</button><button type="button" data-track="workflow-route" data-direction="1" aria-label={t.ui.next}>→</button></div></div></div></section>
    <section class="value container" id="value" aria-labelledby="value-title"><div class="value-heading"><p class="eyebrow">{t.value.eyebrow}</p><h2 class="section-title" id="value-title">{t.value.title}</h2></div><div class="value-model" aria-label={t.value.modelLabel}><div class="value-line"><span>{t.value.currentEffort}</span><p>{t.value.currentFormula}</p></div><div class="value-line"><span>{t.value.otherExposure}</span><p>{t.value.otherFormula}</p></div><div class="value-versus">{t.value.versus}</div><div class="value-line value-cost"><span>{t.value.changeCost}</span><p>{t.value.changeFormula}</p></div><div class="value-result"><span>{t.value.decision}</span><p>{t.value.decisionQuestion}</p></div></div><p class="value-footnote">{t.value.footnote}</p></section>
    <div class="editorial-break"><blockquote>{t.quotes.third}</blockquote></div>
    <section class="approach" id="approach" aria-labelledby="approach-title"><div class="container approach-grid"><div class="approach-intro"><p class="eyebrow">{t.approach.eyebrow}</p><h2 class="section-title" id="approach-title">{t.approach.title}</h2><p class="body-large muted">{t.approach.lead}</p><p class="approach-note">{t.approach.note}</p></div><ol class="principles">{t.approach.stages.map((stage, index) => <li style={`--stack-index:${index};--stack-top:${6.5 + index * .6}rem`}><span class="mono-number">{String(index + 1).padStart(2, '0')}</span><p><strong>{stage.title}.</strong> {stage.detail}</p></li>)}</ol></div></section>
    <section class="contact" id="contact" aria-labelledby="contact-title"><div class="container contact-inner"><p class="eyebrow">{t.contactTeaser.eyebrow}</p><h2 class="section-title" id="contact-title">{t.contactTeaser.title}</h2><p class="body-large">{t.contactTeaser.lead}</p><a class="button-primary" href={pathFor(locale, 'contact')}>{t.contactTeaser.cta} <span aria-hidden="true">↗</span></a><p class="contact-status">{t.contactTeaser.status}</p></div></section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
<script>import '../scripts/motion-entry';</script>
<script>import '../scripts/home-interactions';</script>
